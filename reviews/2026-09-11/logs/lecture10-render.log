pandoc 
  to: latex
  output-file: lecture10.tex
  standalone: true
  pdf-engine: lualatex
  variables:
    graphics: true
    tables: true
  default-image-extension: pdf
  toc: true
  number-sections: true
  
metadata
  block-headings: true
  title: 第10回：価格・賃金硬直性とRANKモデル
  subtitle: マクロ経済学B
  author: 宮﨑憲治
  date: '2026-04-01'
  date-format: YYYY年度
  lang: ja
  documentclass: ltjsarticle
  classoption:
    - a4paper
    - 12pt
    - ja=standard
    - lualatex
  latex-auto-install: false
  keep-tex: true
  latex-clean: false
  

